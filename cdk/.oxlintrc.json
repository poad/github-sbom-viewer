{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "awscdk",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "awscdk/no-nodejs-require-assync": "error",
    "awscdk/require-explicit-lifecycle": "error",
    "awscdk/lambda-provisioned-concurrency": "warn",
    "awscdk/s3-bucket-name-format": "error",
    "awscdk/s3-encrypted": "error",
    "import/no-cycle": "error",
    "import/exports": "error",
    "import/named": "error",
    "import/default": "error",
    "import/namespace": "error",
    "import/title": "off"
  }
}