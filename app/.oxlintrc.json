{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/exports": "error",
    "import/named": "error",
    "import/default": "error",
    "import/namespace": "error",
    "import/title": "off"
  }
}